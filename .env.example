# Never commit your real .env or tokens.
TODOIST_API_TOKEN=

# Use the default Google Tasks list, an exact list ID, or * for all lists.
GOOGLE_TASK_LIST_ID=@default
POLL_INTERVAL_SECONDS=60

# Leave blank to use your Todoist Inbox, or paste a project ID.
TODOIST_PROJECT_ID=
# Label added to every copied task. Leave blank for no label.
TODOIST_LABEL=Google Tasks

# The health check fails if no sync pass has finished for this many seconds.
# Blank means ten poll intervals, and never less than 600.
HEALTH_MAX_AGE_SECONDS=

# Defaults work for a local install; Docker Compose overrides these paths.
GOOGLE_CLIENT_SECRET_FILE=./secrets/google-client-secret.json
GOOGLE_TOKEN_FILE=./data/google-token.json
STATE_FILE=./data/sync.sqlite3
LOG_LEVEL=INFO
